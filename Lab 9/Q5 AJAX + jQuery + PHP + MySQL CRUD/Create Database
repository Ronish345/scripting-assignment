CREATE DATABASE IF NOT EXISTS student_db;

USE student_db;

CREATE TABLE students (
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    roll_no VARCHAR(50) NOT NULL,
    course VARCHAR(100) NOT NULL,
    semester INT NOT NULL
);

